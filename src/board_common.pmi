; The board layer every Pico shares: USB text out, the service call, the LAFVIN ST7796 output, core 1
; (the picture), boot. The chip's board file sets #COCO_CLOCK_KHZ, #COCO_BOARD_NAME$, the ROM region and
; supplies VideoBegin() and CocoLaunchCore1(), and sets #COCO_HEADLESS (1: no panel - the picture is read
; over USB only) and #COCO_DISK_FLASH_SLOTS (how many 160 KB disk slots its flash region holds).

Declare VideoBegin()
Declare.i CocoLaunchCore1()

Global Core1ParkRequest.i, Core1Parked.i, WorkerReady.i

Procedure Say(*text)
  Protected p.i, c.i
  p = *text
  c = PeekA(p) & 255
  While c
    UsbSerialWrite(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure

Procedure Num(v.i)
  Protected d.i
  If v < 0
    UsbSerialWrite(45)
    v = 0 - v
  EndIf
  d = 1
  While v / d >= 10
    d = d * 10
  Wend
  While d > 0
    UsbSerialWrite(48 + (v / d) % 10)
    d = d / 10
  Wend
EndProcedure

Procedure Eol()
  UsbSerialWrite(13) : UsbSerialWrite(10)
  UsbSerialFlush() : UsbSerialTask()
EndProcedure

Procedure CocoBoardService()
  UsbSerialTask() : SafetyPet()
EndProcedure

Procedure WaitUs(us.i)
  Protected t.i
  t = Micros()
  While Micros() - t < us
    CocoBoardService()
  Wend
EndProcedure

; ---------------------------------------------------------------- the panel

Procedure VideoSendRow(y.i, pixels.i)
  CompilerIf #COCO_HEADLESS = 0
    CompilerIf #COCO_PANEL_ASYNC = 1
      CocoRowSend(y, pixels)
    CompilerElse
      Tft796BlitRect(0, y, #VIDEO_OUT_W, 1, pixels)
    CompilerEndIf
  CompilerEndIf
EndProcedure

Procedure VideoSendDone()
  CompilerIf #COCO_HEADLESS = 0 And #COCO_PANEL_ASYNC = 1
    CocoRowFinish()
  CompilerEndIf
EndProcedure

; Core 0 asks core 1 to stop drawing (for a capture over USB, or a flash write) and waits for it.
Procedure CocoParkVideo(on.i)
  Protected t.i
  If on
    Core1ParkRequest = 1
    t = Micros()
    While PeekL(@Core1Parked) = 0 And Micros() - t < 200000
      CocoBoardService()
    Wend
  Else
    Core1ParkRequest = 0
  EndIf
EndProcedure

; Core 1 waits here, in SRAM, while core 0 has the flash down (a disk write) or the picture (a capture).
ProcedureRAM Core1Park()
  Core1Parked = 1
  While PeekL(@Core1ParkRequest) : Wend
  Core1Parked = 0
EndProcedure

; Core 1 draws each picture the machine finishes once - 59.92 a second, the CoCo 3's own rate - and
; between pictures keeps the speaker going. VideoBusyUs is its working time (the status line's
; core1_busy_pct); a picture that takes longer than a frame shows the newest finished one next.
Global Core1Shown.i = -1, Core1T.i
Procedure Core1Main()
  WorkerReady = 1
  Repeat
    If PeekL(@Core1ParkRequest) : Core1Park() : EndIf
    If PeekL(@CocoFrames) <> Core1Shown
      Core1Shown = PeekL(@CocoFrames)
      Core1T = Micros()
      VideoFrame()
      VideoBusyUs = VideoBusyUs + Micros() - Core1T
    Else
      CocoAudioPoll()
    EndIf
  ForEver
EndProcedure

CompilerIf #COCO_SRAM_IMAGES = 1
; The ROM region and one disk slot, sent over USB at boot (see the wrapper).
Global Dim CocoRomImage.a(#ROM_REGION_BYTES)
Global Dim CocoDiskImage.a(#DISK_SLOT_BYTES)
Global ImgT.i, ImgStart.i, ImgKind.i, ImgOff.i, ImgLen.i, ImgCrc.l, ImgDst.i, ImgCap.i, ImgI.i, ImgC.i, ImgBlocks.i

; The next byte from the host, waiting up to 2 s; -1 when none came.
Procedure.i ImgByte()
  ImgT = Micros()
  Repeat
    If UsbSerialAvailable() > 0 : ProcedureReturn UsbSerialRead() : EndIf
    CocoBoardService()
  Until Micros() - ImgT > 2000000
  ProcedureReturn -1
EndProcedure

; Blocks of 'I' kind(0 ROM region, 1 disk slot) offset(4) length(2, at most 4096) data CRC-32(4),
; each answered IMG OK or IMG BAD (and dropped); 'G' ends it. Nothing for 10 s: go on without.
Procedure CocoReceiveImages()
  ; both start as erased flash does, $FF: the sender leaves out trailing 4 KB of $FF (an empty disk's
  ; unused sectors are $FF, and Disk BASIC's FAT calls a granule free by $FF)
  For ImgI = 0 To #ROM_REGION_BYTES - 1 : CocoRomImage(ImgI) = $FF : Next
  For ImgI = 0 To #DISK_SLOT_BYTES - 1 : CocoDiskImage(ImgI) = $FF : Next
  Say("COCO SEND IMAGES rom=") : Num(#ROM_REGION_BYTES) : Say(" disk=") : Num(#DISK_SLOT_BYTES) : Eol()
  ImgStart = Micros()
  Repeat
    ImgC = -1
    If UsbSerialAvailable() > 0 : ImgC = UsbSerialRead() : Else : CocoBoardService() : EndIf
    If ImgC = 71
      Say("IMAGES DONE blocks=") : Num(ImgBlocks) : Eol()
      ProcedureReturn
    EndIf
    If ImgC = 73
      ImgKind = ImgByte()
      ImgOff = ImgByte() | (ImgByte() << 8) | (ImgByte() << 16) | (ImgByte() << 24)
      ImgLen = ImgByte() | (ImgByte() << 8)
      If ImgKind = 0
        ImgDst = @CocoRomImage(0) : ImgCap = #ROM_REGION_BYTES
      Else
        ImgDst = @CocoDiskImage(0) : ImgCap = #DISK_SLOT_BYTES
      EndIf
      If ImgLen > 4096 Or ImgOff < 0 Or ImgOff + ImgLen > ImgCap Or ImgKind < 0 Or ImgKind > 1
        Say("IMG BAD place") : Eol()
      Else
        For ImgI = 0 To ImgLen - 1 : PokeA(ImgDst + ImgOff + ImgI, ImgByte()) : Next
        ImgCrc = ImgByte() | (ImgByte() << 8) | (ImgByte() << 16) | (ImgByte() << 24)
        If CocoCrc32(ImgDst + ImgOff, ImgLen) = ImgCrc
          ImgBlocks = ImgBlocks + 1
          Say("IMG OK") : Eol()
        Else
          Say("IMG BAD crc") : Eol()
        EndIf
      EndIf
      ImgStart = Micros()
    EndIf
  Until Micros() - ImgStart > 10000000
  Say("IMAGES none came in 10 s") : Eol()
EndProcedure

; A disk sector written: into the image in SRAM (kept until the board is reset).
Procedure.i DiskStore(d.i, off.i, src.i)
  Protected i.i
  For i = 0 To 255 : PokeA(DiskBase(d) + off + i, PeekA(src + i)) : Next
  ProcedureReturn 1
EndProcedure
CompilerElse
; A disk sector written: read the flash sector around it, patch, erase, program (disk.pmi's DiskStore).
Global Dim DiskSectorBuf.a(4096)
Procedure.i DiskStore(d.i, off.i, src.i)
  Protected flashOff.i, sect.i, i.i
  flashOff = DiskFlash(d) + off
  sect = flashOff & ~$FFF
  For i = 0 To 4095 : DiskSectorBuf(i) = PeekA($10000000 + sect + i) : Next
  For i = 0 To 255 : DiskSectorBuf((flashOff & $FFF) + i) = PeekA(src + i) : Next
  ProcedureReturn CocoFlashSector(sect, @DiskSectorBuf(0))
EndProcedure
CompilerEndIf

; Erase one 4 KB flash sector and program it from SRAM, with core 1 parked off the flash. Only the disk
; region may be written: anything else is refused (a wrong sector number must never erase the program).
Global CocoFlashRefused.i
Procedure.i CocoFlashSector(offset.i, src.i)
  Protected ok.i
  If offset < #COCO_DISK_OFFSET Or offset + 4096 > #COCO_DISK_OFFSET + #COCO_DISK_FLASH_SLOTS * #DISK_SLOT_BYTES Or (offset & $FFF)
    CocoFlashRefused = CocoFlashRefused + 1
    ProcedureReturn 0
  EndIf
  CocoParkVideo(1)
  If PeekL(@Core1Parked) = 0 : CocoParkVideo(0) : ProcedureReturn 0 : EndIf
  ok = FlashRangeErase(offset, 4096)
  If ok : ok = FlashRangeProgram(offset, src, 4096) : EndIf
  CocoParkVideo(0)
  ProcedureReturn ok
EndProcedure

Global MainT.i, MainE.i
; Everything before the machine starts. Main() itself only calls this and CocoRun(): it is on the
; path down to the 6809 core, which holds CpuB and CpuFZ in r4 and r5 (PM1126).
Procedure CocoBoot()
  SafetyBoot() : ClockInitKhz(#COCO_CLOCK_KHZ) : TimerInit() : UsbSerialInit()
  ; (no call's result is kept across another call on this path: see CocoRun's note on r4-r7)
  MainT = Micros()
  Repeat
    CocoBoardService()
    If UsbSerialReady() : Break : EndIf
  Until Micros() - MainT >= 10000000
  WaitUs(200000)
  Say("CoCo 3 PureMetal ") : Say(#COCO_BOARD_NAME$) : Say(" clk_khz=") : Num(ClockSysKhz()) : Eol()
  VideoInit()
  CompilerIf #COCO_SRAM_IMAGES = 1
    CocoReceiveImages()
    MainE = CocoLoadRoms(@CocoRomImage(0))
  CompilerElse
    MainE = CocoLoadRoms(#COCO_ROM_FLASH)
  CompilerEndIf
  CocoRomError = MainE
  CocoRomMessage(MainE)
  CompilerIf #COCO_SRAM_IMAGES = 1
    DiskInit(@CocoDiskImage(0), 0, 1)
  CompilerElse
    DiskInit($10000000 + #COCO_DISK_OFFSET, #COCO_DISK_OFFSET, #COCO_DISK_FLASH_SLOTS)
  CompilerEndIf
  Say("disks:") : For MainT = 0 To #DISK_SLOTS - 1 : Say(" ") : Num(Bool(DiskBase(MainT) <> 0)) : Next : Eol()
  VideoBegin()
  Say("spi_hz=") : Num(SpiHz(0)) : Eol()
  Say("core1 launch=") : Num(CocoLaunchCore1()) : Eol()
  CocoAudioBegin(#COCO_BTKEY_FLASH)
  MainT = Micros()
  Repeat
    CocoBoardService()
    If PeekL(@WorkerReady) : Break : EndIf
  Until Micros() - MainT >= 1000000
EndProcedure

Procedure Main()
  CocoBoot()
  CocoRun()
EndProcedure

; The CoCo 3 machine's frame (the CPU a scanline at a time and the scanline events), its ROMs and the text
; on its screen. Shared by the Picos (whose run loop and USB monitor are monitor.pmi) and the PC (desktop/).
; The host supplies Say/Num/Eol (its log), CocoPutc(c) and the ROM region's address.
;
; THE ROM REGION (tools/make_rom_region.py writes it, PureMetalForge --storage-write puts it in flash):
;   +$0000  "CC3R", version 1, ROM bytes, ROM CRC-32, cartridge bytes, cartridge CRC-32, font offset
;   +$1000  the CoCo 3 internal ROM (32 KB)
;   +$9000  a cartridge ROM (Disk BASIC), 0 - 16 KB
; The ROMs are the user's own files; they are never in this repository or in the firmware image.

#ROM_REGION_BYTES = $10000

Global CocoFullSpeed.i, CocoReport.i = 1, CocoMonitor.i, CocoMonI.i
Global CocoRunUs.i, CocoWaitUs.i, CocoLate.i, CocoRomError.i
Global CocoStatFrames.i, CocoStatCycles.i, CocoStatAt.i, CocoStatRun.i, CocoStatVideo.i, CocoStatBusy1.i, CocoStatLines.i

Declare CocoBoardService()
Declare CocoParkVideo(on.i)
Declare CocoBoardSetup()                ; the wrapper's: after every reset (a diagnostic sets up a screen here)
Declare CocoFrameHook()                 ; the wrapper's: once a frame
Declare CocoAudioReport()
Declare CocoPutc(c.i)

; ---------------------------------------------------------------- the ROMs

Procedure.l CocoCrc32(addr.i, n.i)
  Protected crc.l, i.i, k.i
  crc = -1
  For i = 0 To n - 1
    crc = crc ! PeekA(addr + i)
    For k = 1 To 8
      If crc & 1
        crc = ((crc >> 1) & $7FFFFFFF) ! $EDB88320
      Else
        crc = (crc >> 1) & $7FFFFFFF
      EndIf
    Next
  Next
  ProcedureReturn ~crc
EndProcedure

; Returns 0, or an error number that CocoRomMessage explains.
Procedure.i CocoLoadRoms(region.i)
  Protected romBytes.i, cartBytes.i, font.i
  CocoRom = 0 : CocoCart = 0 : CocoCartBytes = 0
  If PeekL(region) <> $52334343            ; "CC3R"
    ProcedureReturn 1
  EndIf
  If PeekL(region + 4) <> 1 : ProcedureReturn 2 : EndIf
  romBytes = PeekL(region + 8)
  If romBytes <> 32768 : ProcedureReturn 3 : EndIf
  If CocoCrc32(region + $1000, romBytes) <> PeekL(region + 12) : ProcedureReturn 4 : EndIf
  cartBytes = PeekL(region + 16)
  If cartBytes <> 0 And cartBytes <> 8192 And cartBytes <> 16384 : ProcedureReturn 5 : EndIf
  If cartBytes
    If CocoCrc32(region + $9000, cartBytes) <> PeekL(region + 20) : ProcedureReturn 6 : EndIf
    CocoCart = region + $9000 : CocoCartBytes = cartBytes
  EndIf
  CocoRom = region + $1000
  font = PeekL(region + 24)
  If font > 0 And font <= 32768 - 768
    VideoLoadFont(CocoRom, font)
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure CocoRomMessage(e.i)
  Select e
    Case 0 : Say("CoCo 3 ROM loaded from flash")
    Case 1 : Say("Error 1: no CoCo 3 ROM in flash (the coco_rom region does not start with CC3R). Write it with tools/load_roms.ps1 and your own coco3.rom.")
    Case 2 : Say("Error 2: the ROM region was written by a newer tool than this firmware reads. Rebuild the firmware or the region with the same tools.")
    Case 3 : Say("Error 3: the ROM region does not hold a 32 KB CoCo 3 ROM. Check the file given to make_rom_region.py.")
    Case 4 : Say("Error 4: the CoCo 3 ROM in flash fails its CRC-32: the region is damaged or half written. Write it again with tools/load_roms.ps1.")
    Case 5 : Say("Error 5: the cartridge ROM in the region is not 8 or 16 KB. Check the Disk BASIC file given to make_rom_region.py.")
    Case 6 : Say("Error 6: the cartridge ROM in flash fails its CRC-32. Write the region again with tools/load_roms.ps1.")
  EndSelect
  Eol()
EndProcedure

; ---------------------------------------------------------------- the text on the screen, over USB

Procedure CocoTextDump()
  Protected rows.i, row.i, i.i, d.i, c.i, addr.i, stride.i, cols.i
  VideoDecode()
  If VdText = 0
    Say("TEXT none (graphics mode)") : Eol() : Say("TEXT_END") : Eol() : ProcedureReturn
  EndIf
  cols = VdBytes
  If VdLpr = 255 : rows = 1 : Else : rows = VdBodyLines / VdLpr : EndIf
  stride = 1
  If VdLegacy = 0 : stride = 1 + VdAttr : EndIf
  Say("TEXT_BEGIN cols=") : Num(cols) : Say(" rows=") : Num(rows) : Eol()
  For row = 0 To rows - 1
    addr = VdBase + row * VdPitch
    For i = 0 To cols - 1
      d = PeekA(CocoPhys(addr + i * stride))
      If VdLegacy
        If d & $80
          c = 35                         ; semigraphics: '#'
        Else
          c = d & $3F
          If c < 32
            If d & $40 : c = c + 64 : Else : c = c + 96 : EndIf
          EndIf
        EndIf
      Else
        c = d & $7F
        If c < 32 : c = 46 : EndIf
      EndIf
      CocoPutc(c)
    Next
    Eol()
  Next
  Say("TEXT_END") : Eol()
EndProcedure

; ---------------------------------------------------------------- one frame

; Run the machine through one frame of 262 scanlines: the CPU a line at a time, then the line's events.
; THE PATH DOWN TO CpuRun keeps no locals: the Pico's core holds CpuB and CpuFZ in r4 and r5 for the whole
; program, so a procedure that calls on to it must not keep its own values there (PM1126). Its state is in
; Globals instead (as the 6502 precedent's driver loop).
Global RunNeed.i, RunUsed.i
Declare CocoLineHook()                   ; the host's: after each line (USB service on a Pico)
; A GIME timer that falls due inside a line ends the CPU's window there, so its interrupt (a program making
; a tone with the 279 ns timer, say) comes at the right instruction rather than at the next line.
Global RunTimer.i
ProcedureRAM CocoFrame()
  Repeat
    While CocoLinePos < #GIME_LINE_CLOCKS
      RunNeed = (#GIME_LINE_CLOCKS - CocoLinePos + CocoCycleClocks - 1) / CocoCycleClocks
      If GimeTimerOn
        RunTimer = GimeTimerDue - GimeNow - CocoLinePos
        If RunTimer < #GIME_LINE_CLOCKS - CocoLinePos
          RunNeed = (RunTimer + CocoCycleClocks - 1) / CocoCycleClocks
          If RunNeed < 1 : RunNeed = 1 : EndIf
        EndIf
      EndIf
      CocoFolded = 0
      RunUsed = CocoCpuRun(RunNeed)
      CocoLinePos = CocoLinePos + (RunUsed - CocoFolded) * CocoCycleClocks
      CocoFolded = 0
      If GimeTimerOn : GimeTimerRun(GimeNow + CocoLinePos) : EndIf
    Wend
    CocoLinePos = CocoLinePos - #GIME_LINE_CLOCKS
    CocoEndLine()
    SoundCatchUp(GimeNow)
    CocoLineHook()
  Until CocoLine = 0
EndProcedure

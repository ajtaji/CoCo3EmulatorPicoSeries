; CoCo 3 sound: the 6-bit DAC (PIA1 PA2-PA7, through the sound mux when SNDEN is on) and the single-bit
; output (PIA1 PB1), sampled at 48 kHz against machine time, into a ring the Bluetooth speaker reads.
;
; Each change of the output level first fills the ring up to the moment of the change with the old
; level, so the waveform BASIC's SOUND and PLAY make with timing loops keeps its timing exactly.
; A sample is due every 28636363 / 48000 = 596.59 GIME clocks: 596, plus one when the remainder
; (28363 per sample, out of 48000) carries.
;
; EACH SAMPLE IS THE AVERAGE LEVEL OVER ITS OWN 596 OR 597 CLOCKS, not the level at its end: a square
; wave whose edges fall between samples otherwise comes out with its edges moved to the next sample, and
; that jitter is heard as a fizz of tones that are not in the music (measured 2026-10-24 on the demo's
; tune: non-harmonic peaks at -33 to -37 dB, 16 - 24 kHz). SoundAcc sums level x clocks from SoundMark.

#SOUND_RING = 2048                       ; samples, a power of two (43 ms)

Global Dim SoundRing.w(#SOUND_RING)
Global SoundSamples.i                    ; samples ever written (the speaker's reader follows this)
Global SoundNext.i, SoundFrac.i, SoundValue.i, SoundOn.i
Global SoundPer.i, SoundMark.i, SoundAcc.i

; THE COUPLING CAPACITOR. A real CoCo 3's sound reaches the TV through a capacitor, so a level that stays
; put - the DAC at rest at the OK prompt - is silence. Without it the ring carried a constant -10240
; (31% of full scale) from power-on, which a Bluetooth speaker's codec turned into a steady whine. A one-pole high-pass, 1024 samples (21 ms, 7.5 Hz): SoundHp is the output x 1024; each
; sample adds its step from the last and takes 1/1024 off. A 523 Hz square droops 4% a half period.
; The shifts are taken on a positive value so the rest settles at exactly 0, not -1.
Global SoundHp.i, SoundHpIn.i

Declare.i CocoAudioOn()
; Sampling runs only while something plays the ring.
Procedure SoundStart()
  SoundNext = CocoTime() : SoundFrac = 0 : SoundOn = CocoAudioOn()
  SoundPer = 596 : SoundMark = SoundNext - SoundPer : SoundAcc = 0
EndProcedure

ProcedureRAM SoundCatchUp(now.i)
  Protected v.i, x.i
  If SoundOn = 0 : ProcedureReturn : EndIf
  While now - SoundNext >= 0
    x = (SoundAcc + SoundValue * (SoundNext - SoundMark)) / SoundPer
    SoundAcc = 0 : SoundMark = SoundNext
    SoundPer = 596
    SoundFrac = SoundFrac + 28363
    If SoundFrac >= 48000 : SoundFrac = SoundFrac - 48000 : SoundPer = 597 : EndIf
    SoundNext = SoundNext + SoundPer
    SoundHp = SoundHp + (x - SoundHpIn) * 1024 : SoundHpIn = x
    If SoundHp < 0
      SoundHp = SoundHp + ((0 - SoundHp) >> 10)
      v = 0 - ((0 - SoundHp) >> 10)
    Else
      SoundHp = SoundHp - (SoundHp >> 10)
      v = SoundHp >> 10
    EndIf
    If v > 32767 : v = 32767 : EndIf
    If v < -32767 : v = -32767 : EndIf
    SoundRing(SoundSamples & (#SOUND_RING - 1)) = v
    SoundSamples = SoundSamples + 1
  Wend
EndProcedure

; Called by the PIAs whenever a register the output depends on is written.
ProcedureRAM CocoSoundChanged()
  Protected level.i, now.i
  now = CocoTime()
  SoundCatchUp(now)
  If SoundOn
    SoundAcc = SoundAcc + SoundValue * (now - SoundMark) : SoundMark = now
  EndIf
  level = CocoSoundLevel()
  If CocoSoundOn = 0 And CocoBit = 0
    SoundValue = 0
  Else
    SoundValue = (level - 32) * 640
  EndIf
EndProcedure

; Pico W (RP2040): the LAFVIN ST7796 kit as the NES emulator uses it (SPI0 GP2/GP3 at 100 MHz, CS GP5,
; DC GP6, RST GP7), landscape 480 x 320; 200 MHz. The rest is src/board_common.pmi.

#COCO_CLOCK_KHZ = 200000
#COCO_BOARD_NAME$ = "Pico W"

; The ROM region: flash $140000-$14FFFF, above the radio firmware ($100000-$13FFFF) and clear of the
; NES ROM store ($50000-$FEFFF) other programs on a shared board keep. tools/make_rom_region.py builds
; it as its own .uf2 and the compiler's --radio-firmware door sends it; the program on the board stays.
; (FlashRegion "coco_rom", $140000, $10000, "raw" belongs here once the signed compiler carries
; FlashRegion - the exe of 2026-10-22 18:43 predates it.)
#COCO_ROM_OFFSET = $140000
#COCO_ROM_FLASH = $10000000 + #COCO_ROM_OFFSET
; The disk region: four .DSK slots of $28000 at $150000-$1EFFFF, below the C64 emulator's region ($1F0000)
; and the Bluetooth key ($1FF000) other programs keep on the same board.
#COCO_DISK_OFFSET = $150000
#COCO_DISK_FLASH_SLOTS = 4
#COCO_HEADLESS = 0
#COCO_PANEL_ASYNC = 1                    ; rows go out by DMA while the next line is drawn (board_common.pmi)
#COCO_DMA_TREQ_SHIFT = 15                ; the RP2040's DMA CTRL TREQ_SEL field (spi.pico's SpiDmaSend16)
#COCO_SRAM_IMAGES = 0                    ; the ROMs and disks are in flash (the RP2040 has no SRAM to spare)
; The speaker link key the NES firmware keeps ("BTK1"), read only.
#COCO_BTKEY_FLASH = $101FF000

Procedure VideoBegin()
  SpiPeriFromSys(200000)
  SpiBegin(0, 2, 3, -1, 100000)
  Tft796Begin(0, 5, 6, 7) : Tft796Rotate(1) : Tft796Fill(0)
EndProcedure

Procedure.i CocoLaunchCore1()
  ProcedureReturn multicore_launch()
EndProcedure

XIncludeFile "../src/board_common.pmi"

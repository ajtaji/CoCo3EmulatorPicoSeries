; Tandy Color Computer 3 for the Pico 2 W (RP2350): the 6809 core of 6809EmulatorPicoSeries (cloned
; beside this repository), 128 KB of CoCo RAM, the LAFVIN ST7796 panel, the keyboard over USB serial.
; The ROMs come from the ROM region in flash (tools/make_rom_region.py); none are in this image.
; (rp2350/coco3_usbimages.pico2w is the same machine taking its ROMs and one disk over USB into SRAM at
; boot, for a board whose flash is full.)
#CPU_TIMING = 1
#CPU_ASM_TAIL = 1
#VIDEO_RGB = 0
#COCO_AUDIO = 0                          ; the public firmware names no speaker: no sound
#COCO_BOARD_NAME$ = "Pico 2 W"
#COCO_SRAM_IMAGES = 0
; The ROM region: $3E0000-$3EFFFF of the 4 MB flash (make_rom_region.py --target rp2350 --offset 0x3E0000);
; the last sector, $3FF000, is left for a Bluetooth link key. A board that keeps other firmware's stores
; in its upper flash must agree a different split first.
#COCO_ROM_OFFSET = $3E0000
; The disk region: four .DSK slots of $28000 at $300000-$39FFFF (make_disk_region.py --target rp2350
; --offset 0x300000).
#COCO_DISK_OFFSET = $300000
#COCO_DISK_FLASH_SLOTS = 4
#COCO_BTKEY_FLASH = $103FF000
#COCO_HEADLESS = 0
XIncludeFile "coco3_body.pico2"

Procedure CocoBoardSetup()
EndProcedure

Procedure CocoFrameHook()
EndProcedure

Main()

; Tandy Color Computer 3 for the Adafruit Feather RP2350 HSTX (the same RP2350A as a Pico 2 W; the Pico 2 W
; build runs on it): 128 KB of CoCo RAM, NO panel - the picture is read over USB (monitor c), the keyboard
; over USB serial. Its flash ranges leave room for other programs' stores on the same 8 MB board.
; The ROMs come from the coco_rom flash region (tools/make_rom_region.py); none are in this image.
#CPU_TIMING = 1
#CPU_ASM_TAIL = 1
#VIDEO_RGB = 0
#COCO_AUDIO = 0                          ; the public firmware names no speaker: no sound
#COCO_BOARD_NAME$ = "Feather RP2350 HSTX"
; The 8 MB flash is shared with other programs' stores on the board this was proven on; the CoCo 3 takes
; the ROM region $4A2000-$4BFFFF (make_rom_region.py --target rp2350 --offset 0x4A2000) and ONE disk slot
; at $6B5000-$6DCFFF of the $6B5000-$6FFFFF gap (make_disk_region.py --target rp2350 --offset 0x6B5000).
#COCO_ROM_OFFSET = $4A2000
#COCO_DISK_OFFSET = $6B5000
#COCO_DISK_FLASH_SLOTS = 1
#COCO_BTKEY_FLASH = 0
#COCO_HEADLESS = 1
#COCO_SRAM_IMAGES = 0                    ; the ROMs and the disk are in its flash ranges
XIncludeFile "coco3_body.pico2"

Procedure CocoBoardSetup()
EndProcedure

Procedure CocoFrameHook()
EndProcedure

Main()

; Pico 2 W and other RP2350 Arm boards: the same LAFVIN ST7796 wiring as the Pico W (SPI0 GP2/GP3, CS GP5, DC GP6,
; RST GP7), landscape 480 x 320; 150 MHz, the SPI from clk_sys (75 MHz). Core 1 is the second M33
; (multicore_smp.pico2). The rest is src/board_common.pmi.

#COCO_CLOCK_KHZ = 150000
#COCO_ROM_FLASH = $10000000 + #COCO_ROM_OFFSET
; The wrapper names the board and its flash: #COCO_BOARD_NAME$, #COCO_ROM_OFFSET, #COCO_DISK_OFFSET,
; #COCO_DISK_FLASH_SLOTS, #COCO_BTKEY_FLASH, #COCO_HEADLESS (coco3.pico2w: a Pico 2 W with the LAFVIN
; panel; coco3_feather.pico2w: the Adafruit Feather RP2350 HSTX, no panel).

Procedure VideoBegin()
  CompilerIf #COCO_HEADLESS = 0
    SpiPeriFromSys(ClockSysConfigKhz())
    SpiBegin(0, 2, 3, -1, 100000)
    Tft796Begin(0, 5, 6, 7) : Tft796Rotate(1) : Tft796Fill(0)
  CompilerEndIf
EndProcedure

#COCO_PANEL_ASYNC = 1                    ; rows go out by DMA while the next line is drawn (board_common.pmi)
#COCO_DMA_TREQ_SHIFT = 17                ; the RP2350's DMA CTRL TREQ_SEL field (spi.pico2's #SPI_DMA_TREQ_SHIFT)

Procedure.i CocoLaunchCore1()
  McCore1ReleaseHold()
  If McLaunchCore1() = 6 : ProcedureReturn 1 : EndIf
  ProcedureReturn 0
EndProcedure

XIncludeFile "../src/board_common.pmi"

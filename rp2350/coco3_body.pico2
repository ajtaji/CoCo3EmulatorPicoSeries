; Everything a CoCo 3 build for this board includes. The wrapper sets #CPU_TIMING = 1, #CPU_ASM_TAIL,
; #VIDEO_RGB and #COCO_AUDIO (1: the Bluetooth speaker libraries; a private wrapper then names the
; speaker), defines CocoBoardSetup() and CocoFrameHook(), and calls Main().
EnableExplicit
XIncludeFile "RP2350/Lib/multicore_smp.pico2"
XIncludeFile "RP2350/Lib/clocks.pico2"
XIncludeFile "RP2350/Lib/timer.pico2"
XIncludeFile "RP2350/Lib/uart.pico2"
XIncludeFile "RP2350/Lib/usb_serial.pico2"
XIncludeFile "RP2350/Lib/safety.pico2"
XIncludeFile "RP2350/Lib/flashid.pico2"
XIncludeFile "RP2350/Lib/flash.pico2"
XIncludeFile "RP2350/Lib/spi.pico2"
XIncludeFile "RP2350/Lib/st7796.pico2"
XIncludeFile "../../6809EmulatorPicoSeries/src/cpu6809.pico2"
XIncludeFile "../src/cpu6809_glue.pmi"
XIncludeFile "../src/machine.pmi"
XIncludeFile "../src/video.pmi"
XIncludeFile "../src/keyboard.pmi"
XIncludeFile "../src/sound.pmi"
XIncludeFile "../src/disk.pmi"
CompilerIf #COCO_AUDIO = 1
  XIncludeFile "RP2350/Lib/bits.pico2"
  XIncludeFile "RP2350/Lib/wiring.pico2"
  XIncludeFile "RP2350/Lib/string_out.pico2"
  XIncludeFile "RP2350/Lib/cyw43_nvram.pico2"
  XIncludeFile "RP2350/Lib/cyw43.pico2"
  XIncludeFile "RP2350/Lib/cyw43_btfw.pico2"
  XIncludeFile "RP2350/Lib/bluetooth.pico2"
  XIncludeFile "Shared/Bluetooth/sbc.pmi"
  XIncludeFile "Shared/Bluetooth/bt_audio.pmi"
  XIncludeFile "../src/audio_bt.pmi"
CompilerElse
  XIncludeFile "../src/audio_none.pmi"
CompilerEndIf
XIncludeFile "../src/coco3.pmi"
XIncludeFile "board.pico2"

